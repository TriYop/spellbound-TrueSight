     // -------------------------------------------------------------------
 
     int lv2ui_idle()
+    {
+        const int ret = lv2ui_idle_internal();
+        notifyHostOfSizeChange();
+        return ret;
+    }
+
+    // plugin-initiated resizes (UI::setSize) are not reported to LV2 hosts by DPF,
+    // so tell the host through the ui:resize feature whenever the real window size changed
+    void notifyHostOfSizeChange()
+    {
+        if (fUiResize == nullptr || fUiResize->ui_resize == nullptr)
+            return;
+
+        const uint width = fUI.getWidth();
+        const uint height = fUI.getHeight();
+
+        if (width == 0 || height == 0 || (width == fLastNotifiedWidth && height == fLastNotifiedHeight))
+            return;
+
+        fLastNotifiedWidth = width;
+        fLastNotifiedHeight = height;
+        fUiResize->ui_resize(fUiResize->handle, static_cast<int>(width), static_cast<int>(height));
+    }
+
+    int lv2ui_idle_internal()
     {
         if (fWinIdWasNull)
             return (fUI.plugin_idle() && fUI.isVisible()) ? 0 : 1;
